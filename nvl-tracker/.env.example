# =============================================================================
# Mẫu biến môi trường — copy thành .env và điền giá trị thật
#   cp .env.example .env
# =============================================================================

# --- Ứng dụng ---
TZ=Asia/Ho_Chi_Minh
# Token bảo vệ endpoint POST /api/run (để trống = không bảo vệ, chỉ dùng nội bộ)
API_TOKEN=doi-thanh-chuoi-bi-mat

# File cấu hình nguồn crawl (tương đối so với thư mục backend)
SOURCES_FILE=sources.yaml

# --- Claude API (Anthropic) ---
# Lấy key tại https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-8
# Mức "effort" cho phân tích: low | medium | high | max
ANTHROPIC_EFFORT=high

# --- Telegram ---
# Tạo bot qua @BotFather để lấy token; lấy chat_id qua @userinfobot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# --- Supabase ---
# Project Settings > API. Dùng service_role key cho backend.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOi...

# --- Lịch tự động ---
SCHEDULE_ENABLED=true
# Cron: phút giờ ngày tháng thứ. Mặc định 7h sáng thứ Hai hàng tuần.
SCHEDULE_CRON=0 7 * * 1
